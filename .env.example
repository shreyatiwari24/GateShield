# ===========================================
# GateShield - Environment Configuration Template
# ===========================================
# Copy this file to .env and configure your values:
#   cp .env.example .env

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- PostgreSQL Database ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=your_postgres_username
PG_PASSWORD=your_secure_postgres_password
PG_DATABASE=gateshield

# --- API Gateway Service ---
GATEWAY_PORT=3000
RATE_LIMITER_URL=http://localhost:8081

# --- C++ Rate Limiter Service ---
RATE_LIMITER_PORT=8081

# --- Sample Upstream Backend Service ---
BACKEND_PORT=4000

# --- React Dashboard Frontend ---
DASHBOARD_PORT=5173
VITE_API_URL=http://localhost:3000

# --- Admin Authentication & JWT ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# --- Production Security ---
CORS_ORIGIN=https://your-dashboard-domain.example
